<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".PointShopActivity">

    <!-- 제목 -->
    <TextView
        android:id="@+id/tvShopTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="포인트 헬스 상점"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp" />

    <!-- 보유 포인트 -->
    <TextView
        android:id="@+id/tvCurrentPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보유 포인트: 0"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvShopTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- 상품 목록 -->
    <LinearLayout
        android:id="@+id/llItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentPoints"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:padding="16dp">

        <!-- 계란 한 팩 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="계란 한 팩 (1000p)" />
            <Button
                android:id="@+id/btnBuyEggs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매" />
        </LinearLayout>

        <!-- 고구마 한 팩 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="고구마 한 팩 (1000p)" />
            <Button
                android:id="@+id/btnBuySweetPotatoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매" />
        </LinearLayout>

        <!-- 닭 가슴살 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="닭 가슴살 (1000p)" />
            <Button
                android:id="@+id/btnBuyChicken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매" />
        </LinearLayout>

        <!-- 프로틴 쉐이크 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="프로틴 쉐이크 (2000p)" />
            <Button
                android:id="@+id/btnBuyProteinShake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매" />
        </LinearLayout>

        <!-- 헬스 스트랩 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="헬스 스트랩 (3000p)" />
            <Button
                android:id="@+id/btnBuyStrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구매" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

